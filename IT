// =====================================================
//  ARENALAR
// =====================================================
const ARENAS = [
  { id: "desert", name: "Cho'l", price: 0, bg: "#c9a96b", wall: "#6b4423", wallTop: "#8a5a2f", wallLine: "#3d2410",
    bush: "rgba(34,139,34,.78)", bushLine: "#145214", ice: false,
