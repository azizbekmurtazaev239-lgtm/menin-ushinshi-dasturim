<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Arena Brawl PRO</title>
<style>
  html, body { margin: 0; height: 100%; background: #1b1033; overflow: hidden; font-family: Arial, sans-serif; }
  canvas { display: block; cursor: crosshair; }

  #menu {
    position: fixed; inset: 0; overflow-y: auto; z-index: 5;
    background: rgba(20,8,45,.94); color: #fff; padding: 20px 16px 40px; text-align: center;
  }
  #menu h1 { font-size: 40px; margin: 6px 0; letter-spacing: 3px; color: #ffd43b; text-shadow: 0 4px 0 #6a3d00; }
  #menu h2 { margin: 22px 0 10px; font-size: 20px; color: #d9ccff; }
  #coins { display: inline-block; background: #3a2400; color: #ffd43b; font-weight: bold; font-size: 22px;
           padding: 8px 20px; border-radius: 30px; border: 3px solid #ffd43b; margin: 6px 0; }
  #result { min-height: 24px; font-size: 18px; font-weight: bold; margin: 8px 0; }
  .grid { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; max-width: 1000px; margin: 0 auto; }
  .card {
    width: 200px; background: #2d1b54; border: 3px solid #4a3480; border-radius: 12px;
    padding: 12px; cursor: pointer; transition: transform .1s; text-align: left;
  }
  .card:hover { transform: translateY(-3px); }
  .card.sel { border-color: #ffd43b; background: #3d2a70; }
  .card.locked { opacity: .85; }
  .card .ic { font-size: 38px; text-align: center; }
  .card .nm { font-size: 18px; font-weight: bold; text-align: center; margin: 2px 0 6px; }
  .card .st { font-size: 13px; color: #cbbcff; line-height: 1.45; }
  .card .st b { color: #fff; }
  .card .btn { margin-top: 8px; display: block; width: 100%; padding: 7px 0; border: 0; border-radius: 6px;
               font-weight: bold; font-size: 14px; cursor: pointer; }
  .btn.buy { background: #ffd43b; color: #3a2400; }
  .btn.buy.no { background: #555; color: #aaa; cursor: not-allowed; }
  .btn.own { background: #4ade80; color: #06310f; cursor: default; }
  .btn.picked { background: #ffd43b; color: #3a2400; cursor: default; }
  #startBtn {
    margin-top: 26px; padding: 14px 54px; font-size: 24px; font-weight: bold;
    border: 0; border-radius: 10px; background: #4ade80; color: #06310f; cursor: pointer; box-shadow: 0 6px 0 #1e8f46;
  }
  #hint { color: #bba9f5; font-size: 14px; margin-top: 12px; }
</style>
</head>
<body>
<canvas id="game"></canvas>

<div id="menu">
  <h1>ARENA BRAWL PRO</h1>
  <div id="coins"></div>
  <div id="result"></div>
  <h2>Personajni tanlang</h2>
  <div class="grid" id="chars"></div>
  <h2>Arenani tanlang</h2>
  <div class="grid" id="arenas"></div>
  <button id="startBtn">O'YNASH</button>
  <div id="hint">WASD — yurish | Sichqoncha — otish | Space — SUPER | Maqsad: 12 ta kristall yig'ish</div>
</div>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const menuEl = document.getElementById("menu");

// =====================================================
//  PERSONAJLAR  (xohlagan personaj qo'shishingiz mumkin)
// =====================================================
const CHARS = [
